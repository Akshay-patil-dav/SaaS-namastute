# =============================================================================
#  Namastute POS — BACKEND Environment Variables EXAMPLE
#  File: backend/.env.example
#  ▸ Copy this file to backend/.env and fill in your real values.
#  ▸ This example file IS safe to commit to Git (no real secrets here).
#
#  HOW TO SWITCH ENVIRONMENTS:
#   LOCAL  → uncomment the LOCAL block, comment out the PRODUCTION block
#   SERVER → uncomment the PRODUCTION block, comment out the LOCAL block
# =============================================================================

SERVER_PORT=3000

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🖥  DATABASE — LOCAL (PostgreSQL on your machine)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/otp_auth_db
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=your_local_db_password

SPRING_DATASOURCE_URL=jdbc:postgresql://dpg-d88p9cek1jcs73fpc33g-a.oregon-postgres.render.com:5432/namustutam_db?sslmode=require
SPRING_DATASOURCE_USERNAME=namustutam_db_user
SPRING_DATASOURCE_PASSWORD=V1EyJzIg7Ca4vzf2X12tc8Oszb1eifxR

# ☁  DATABASE — SERVER (Render PostgreSQL — uncomment for production)
# SPRING_DATASOURCE_URL=jdbc:postgresql://dpg-xxxxxxxxxxxx.oregon-postgres.render.com:5432/your_db_name?sslmode=require
# SPRING_DATASOURCE_USERNAME=your_render_db_user
# SPRING_DATASOURCE_PASSWORD=your_render_db_password

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🔑 JWT
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
JWT_SECRET=your_jwt_hex_secret_here
JWT_EXPIRATION=86400000

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🌐 APPLICATION URLS
#    Only ONE value per variable — no commas.
#    Uncomment the environment you want to run.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 🖥  LOCAL — backend URL (Spring Boot runs on port 3000)
APP_BASE_URL=http://localhost:3000
# ☁  SERVER — uncomment for Render deployment
# APP_BASE_URL=http://localhost:3000

# 🖥  LOCAL — frontend URL (Vite dev server)
FRONTEND_URL=http://localhost:5173
# ☁  SERVER — uncomment for Vercel deployment
# FRONTEND_URL=https://saa-s-namastute.vercel.app

# Extra CORS origins allowed in addition to FRONTEND_URL above.
# Covers both local Vite port and all production domains simultaneously.
CORS_EXTRA_ORIGINS=http://localhost:5174,https://saa-s-namastute.vercel.app,http://localhost:3000

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🔐 OAUTH2 — Google
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# 🔐 OAUTH2 — Facebook
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_FACEBOOK_CLIENT_ID=YOUR_FACEBOOK_CLIENT_ID
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_FACEBOOK_CLIENT_SECRET=YOUR_FACEBOOK_CLIENT_SECRET

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 📧 SMTP (optional — for OTP / invite emails)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=your-email@gmail.com
# SPRING_MAIL_PASSWORD=your-app-password

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🚇 NGROK (optional — expose local backend publicly)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# NGROK_URL=https://xxxx.ngrok-free.app
