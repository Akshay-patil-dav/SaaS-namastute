# =============================================================================
#  Namastute POS — BACKEND Environment Variables EXAMPLE
#  File: backend/.env.example
#  ▸ Copy this file to backend/.env and fill in your real values.
#  ▸ This example file IS safe to commit to Git (no real secrets here).
# =============================================================================

SERVER_PORT=3000

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/otp_auth_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_db_password_here

JWT_SECRET=your_jwt_hex_secret_here
JWT_EXPIRATION=86400000

APP_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_FACEBOOK_CLIENT_ID=YOUR_FACEBOOK_CLIENT_ID
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_FACEBOOK_CLIENT_SECRET=YOUR_FACEBOOK_CLIENT_SECRET

# Optional SMTP
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=your-email@gmail.com
# SPRING_MAIL_PASSWORD=your-app-password

# Optional ngrok
# NGROK_URL=https://xxxx.ngrok-free.app
