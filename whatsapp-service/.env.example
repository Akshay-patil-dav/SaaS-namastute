# WhatsApp Service Configuration
PORT=3005
SERVICE_API_KEY=change-me-to-a-long-random-secret-key

# CORS: allow backend and frontend origins (comma separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,https://awhile-venus-unlearned.ngrok-free.dev,https://namustutamsaas.vercel.app

# Puppeteer config - set to true if running headlessly on Linux server
PUPPETEER_NO_SANDBOX=false

# Session data directory (relative to project root)
WA_SESSION_DIR=./wa-sessions
