# =============================================================================
#  Namastute POS — FRONTEND Environment Variables EXAMPLE
#  File: frontend/.env.example
#  ▸ Copy this file to frontend/.env for local dev.
#  ▸ Copy this file to frontend/.env.production for production builds.
#  ▸ This example file IS safe to commit to Git (no real secrets here).
#
#  HOW TO SWITCH ENVIRONMENTS:
#   LOCAL  → uncomment the LOCAL lines, comment out the SERVER lines
#   SERVER → uncomment the SERVER lines, comment out the LOCAL lines
# =============================================================================

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🌐 BACKEND API URL
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 🖥  LOCAL — Spring Boot running on port 3000
VITE_API_BASE_URL=https://springboot-app-pb1v.onrender.com/api
VITE_BACKEND_BASE_URL=https://springboot-app-pb1v.onrender.com

# ☁  SERVER — Render backend (uncomment for production or cloud testing)
# VITE_API_BASE_URL=https://springboot-app-pb1v.onrender.com/api
# VITE_BACKEND_BASE_URL=https://springboot-app-pb1v.onrender.com

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🌐 FRONTEND URL
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 🖥  LOCAL — Vite dev server
VITE_FRONTEND_URL=http://localhost:5173

# ☁  SERVER — Vercel production (uncomment for production)
# VITE_FRONTEND_URL=https://saa-s-namastute.vercel.app

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🏷  APP BRANDING
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
VITE_APP_NAME=Namastute POS
VITE_APP_VERSION=1.0.0

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🚩 FEATURE FLAGS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
VITE_ENABLE_GOOGLE_LOGIN=true
VITE_ENABLE_FACEBOOK_LOGIN=true
VITE_ENABLE_BLOG=true
