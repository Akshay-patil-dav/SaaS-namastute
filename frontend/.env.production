# =============================================================================
#  Namastute POS — FRONTEND Production Environment Variables
#  File: frontend/.env.production
#  ▸ Vite automatically loads this file during: npm run build
#  ▸ Vercel dashboard values override these (Settings → Environment Variables)
#  ▸ This file is safe to commit (no secrets — only public URLs)
#
#  HOW TO SWITCH ENVIRONMENTS:
#   LOCAL  → uncomment the LOCAL lines, comment out the SERVER lines
#   SERVER → uncomment the SERVER lines, comment out the LOCAL lines (default)
# =============================================================================

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🌐 BACKEND API URL
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 🖥  LOCAL — Spring Boot on port 3000 (uncomment for local production builds)
# VITE_API_BASE_URL=https://springboot-app-pb1v.onrender.com/api
# VITE_BACKEND_BASE_URL=https://springboot-app-pb1v.onrender.com

# ☁  SERVER — Render backend (active — used by Vercel deploys)
VITE_API_BASE_URL=https://springboot-app-pb1v.onrender.com/api
VITE_BACKEND_BASE_URL=https://springboot-app-pb1v.onrender.com

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🌐 FRONTEND URL
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 🖥  LOCAL — Vite dev server (uncomment for local production builds)
# VITE_FRONTEND_URL=http://localhost:5173

# ☁  SERVER — Vercel production URL (active)
VITE_FRONTEND_URL=https://saa-s-namastute.vercel.app

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🏷  APP BRANDING
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
VITE_APP_NAME=Namastute POS
VITE_APP_VERSION=1.0.0

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🚩 FEATURE FLAGS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
VITE_ENABLE_GOOGLE_LOGIN=true
VITE_ENABLE_FACEBOOK_LOGIN=true
VITE_ENABLE_BLOG=true
