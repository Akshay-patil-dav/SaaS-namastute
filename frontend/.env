# =============================================================================
#  Namastute POS — FRONTEND Local Development Environment Variables
#  File: frontend/.env
#  ▸ Used when running: npm run dev
#  ▸ For production builds Vite automatically uses: frontend/.env.production
#  ▸ Do NOT commit this file to Git (it's in .gitignore).
#
#  HOW TO SWITCH ENVIRONMENTS:
#   LOCAL  → uncomment the LOCAL lines, comment out the SERVER lines
#   SERVER → uncomment the SERVER lines, comment out the LOCAL lines
# =============================================================================

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🌐 BACKEND API URL
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 🖥  LOCAL — Spring Boot running on port 3000 (active for local dev)
VITE_API_BASE_URL=https://springboot-app-pb1v.onrender.com/api
VITE_BACKEND_BASE_URL=https://springboot-app-pb1v.onrender.com

# ☁  SERVER — Render backend (uncomment to use cloud backend while running locally)
# VITE_API_BASE_URL=https://springboot-app-pb1v.onrender.com/api
# VITE_BACKEND_BASE_URL=https://springboot-app-pb1v.onrender.com

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🌐 FRONTEND URL
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 🖥  LOCAL — Vite dev server (active for local dev)
VITE_FRONTEND_URL=https://saa-s-namastute.vercel.app

# ☁  SERVER — Vercel production URL (uncomment when using cloud backend)
# VITE_FRONTEND_URL=https://saa-s-namastute.vercel.app

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🏷  APP BRANDING
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
VITE_APP_NAME=Namastute POS
VITE_APP_VERSION=1.0.0

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🚩 FEATURE FLAGS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
VITE_ENABLE_GOOGLE_LOGIN=true
VITE_ENABLE_FACEBOOK_LOGIN=true
VITE_ENABLE_BLOG=true