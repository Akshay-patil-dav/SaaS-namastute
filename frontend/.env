# =============================================================================
#  Namastute POS — FRONTEND Environment Variables
#  File: frontend/.env
#  ▸ All variables MUST be prefixed with VITE_ to be exposed to the browser.
#  ▸ Change values here ONLY — never hardcode URLs in .jsx / .js files.
#  ▸ Restart the dev server (npm run dev) after changing this file.
#  ▸ Do NOT commit this file to Git (it's in .gitignore).
# =============================================================================

# ── Backend API Base URL ──────────────────────────────────────────────────────
# Base URL for all API calls — append /api endpoints after this
VITE_API_BASE_URL=https://springboot-app-pb1v.onrender.com/api

# ── Backend Root URL ──────────────────────────────────────────────────────────
# Used for OAuth2 redirects (/oauth2/authorization/google, /facebook)
VITE_BACKEND_BASE_URL=https://springboot-app-pb1v.onrender.com

# ── Frontend URL ──────────────────────────────────────────────────────────────
# The URL where the frontend is served (used for links, redirects, etc.)
VITE_FRONTEND_URL=https://saa-s-namastute.vercel.app/

# ── App Name & Branding ───────────────────────────────────────────────────────
VITE_APP_NAME=Namastute POS
VITE_APP_VERSION=1.0.0

# ── Feature Flags ─────────────────────────────────────────────────────────────
# Set to "true" or "false" to toggle features without changing code
VITE_ENABLE_GOOGLE_LOGIN=true
VITE_ENABLE_FACEBOOK_LOGIN=true
VITE_ENABLE_BLOG=true

# ── ngrok / Production Override ───────────────────────────────────────────────
# Uncomment and set when accessing the backend through ngrok or a deployed URL:
# VITE_API_BASE_URL=https://xxxx.ngrok-free.app/api
# VITE_BACKEND_BASE_URL=https://xxxx.ngrok-free.app