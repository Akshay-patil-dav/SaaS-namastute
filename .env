# =============================================================================
#  Namustutam POS — ROOT Environment Variables
#  File: .env  (project root)
#  ▸ This is the MASTER reference. Individual .env files in /backend and
#    /frontend are the actual files loaded at runtime.
#  ▸ Do NOT commit this file to Git (it's in .gitignore).
#  ▸ See backend/.env.example and frontend/.env.example for templates.
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=otp_auth_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root

# ── Backend (Spring Boot) ─────────────────────────────────────────────────────
SERVER_PORT=3000
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/otp_auth_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=root

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000

# ── Application URLs ──────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ── OAuth2 — Google ───────────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com → Credentials
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=

# ── OAuth2 — Facebook ─────────────────────────────────────────────────────────
# Get from: https://developers.facebook.com → My Apps
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_FACEBOOK_CLIENT_ID=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_FACEBOOK_CLIENT_SECRET=

# ── Frontend Build Vars (Vite — must be prefixed with VITE_) ─────────────────
VITE_API_BASE_URL=http://localhost:3000/api
VITE_BACKEND_BASE_URL=http://localhost:3000
VITE_FRONTEND_URL=http://localhost:5173
VITE_APP_NAME=Namustutam POS
VITE_APP_VERSION=1.0.0
VITE_ENABLE_GOOGLE_LOGIN=true
VITE_ENABLE_FACEBOOK_LOGIN=true
VITE_ENABLE_BLOG=true

# ── Optional SMTP ──────────────────────────────────────────────────────────────
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=your-email@gmail.com
# SPRING_MAIL_PASSWORD=your-app-password

# ── Optional ngrok / Tunnel ────────────────────────────────────────────────────
# Set when exposing backend externally via ngrok:
# NGROK_URL=https://xxxx.ngrok-free.app
